{
  "application": {
    "meta": {
      "framework": "Y Combinator inspired",
      "purpose": "Startup Studio Application and Founder Evaluation",
      "scoring_ready": true
    },
    "sections": [
      {
        "id": "founder_team",
        "title": "Founder & Team",
        "description": "Evaluate founder quality, commitment, and execution capability",
        "questions": [
          { "id": "founder_full_name", "type": "text", "label": "Founder full name" },
          { "id": "founder_email", "type": "email", "label": "Founder email" },
          { "id": "founder_linkedin", "type": "url", "label": "LinkedIn profile" },
          { "id": "founder_github", "type": "url", "label": "GitHub or portfolio" },
          { "id": "founder_country", "type": "text", "label": "Country" },
          { "id": "founder_timezone", "type": "text", "label": "Time zone" },
          { "id": "full_time", "type": "boolean", "label": "Are you working full-time on this?" },
          { "id": "full_time_date", "type": "date", "label": "If not, when will you?" },
          { "id": "team_members", "type": "repeatable_object", "label": "Founders", "fields": ["name", "role", "equity"] },
          { "id": "worked_together", "type": "boolean", "label": "Have you worked together before?" },
          { "id": "how_met", "type": "long_text", "label": "How did you meet?" },
          { "id": "founder_strengths", "type": "long_text", "label": "What is each founder uniquely good at?" },
          { "id": "who_codes", "type": "text", "label": "Who writes the code?" },
          { "id": "who_talks_customers", "type": "text", "label": "Who talks to customers?" },
          { "id": "who_sells", "type": "text", "label": "Who sells?" },
          { "id": "hardest_thing", "type": "long_text", "label": "What is the hardest thing you have ever built or achieved?" },
          { "id": "rare_achievement", "type": "long_text", "label": "What have you done that few people your age could do?" },
          { "id": "why_you", "type": "long_text", "label": "Why are you the right team to solve this problem?" },
          { "id": "unfair_advantage", "type": "long_text", "label": "What gives you an unfair advantage?" }
        ]
      },
      {
        "id": "problem",
        "title": "The Problem",
        "questions": [
          { "id": "problem_statement", "type": "long_text", "label": "What problem are you solving?" },
          { "id": "target_user", "type": "long_text", "label": "Who has this problem?" },
          { "id": "current_solution", "type": "long_text", "label": "How do they solve it today?" },
          { "id": "pain_level", "type": "long_text", "label": "Why is this problem painful?" },
          { "id": "no_solution_cost", "type": "long_text", "label": "What happens if they don’t solve it?" },
          { "id": "frequency", "type": "text", "label": "How often does this problem occur?" },
          { "id": "why_unsolved", "type": "long_text", "label": "Why hasn’t it already been solved?" }
        ]
      },
      {
        "id": "solution",
        "title": "The Solution",
        "questions": [
          { "id": "product_description", "type": "long_text", "label": "What is your product?" },
          { "id": "one_sentence", "type": "text", "label": "Describe it in one sentence" },
          { "id": "demo", "type": "url", "label": "Demo or prototype link" },
          { "id": "core_action", "type": "text", "label": "Core user action" },
          { "id": "why_better", "type": "long_text", "label": "Why is it 10x better?" },
          { "id": "unique_insight", "type": "long_text", "label": "What is your unique insight?" }
        ]
      },
      {
        "id": "traction",
        "title": "Users & Traction",
        "questions": [
          { "id": "has_users", "type": "boolean", "label": "Do you have users?" },
          { "id": "user_count", "type": "number", "label": "How many users?" },
          { "id": "growth_rate", "type": "text", "label": "Growth rate" },
          { "id": "active_users", "type": "number", "label": "Active users" },
          { "id": "use_case", "type": "long_text", "label": "What do users use it for?" },
          { "id": "shutdown_reaction", "type": "long_text", "label": "What happens if you shut it down?" },
          { "id": "sad_users", "type": "number", "label": "How many would be sad?" },
          { "id": "user_feedback", "type": "long_text", "label": "Paste real user quotes" }
        ]
      },
      {
        "id": "market",
        "title": "Market & Scale",
        "questions": [
          { "id": "customer", "type": "text", "label": "Who is your customer?" },
          { "id": "payer", "type": "text", "label": "Who pays?" },
          { "id": "price", "type": "number", "label": "How much do they pay?" },
          { "id": "market_size", "type": "long_text", "label": "Market size" },
          { "id": "timing", "type": "long_text", "label": "Why now?" },
          { "id": "change", "type": "long_text", "label": "What changed recently?" }
        ]
      },
      {
        "id": "competition",
        "title": "Competition",
        "questions": [
          { "id": "competitors", "type": "long_text", "label": "Who are your competitors?" },
          { "id": "alternatives", "type": "long_text", "label": "What do users do instead?" },
          { "id": "why_choose_you", "type": "long_text", "label": "Why choose you?" },
          { "id": "bigco_threat", "type": "long_text", "label": "How could a big company kill you?" },
          { "id": "defensibility", "type": "long_text", "label": "Why won’t they?" }
        ]
      },
      {
        "id": "business_model",
        "title": "Business Model",
        "questions": [
          { "id": "revenue_model", "type": "long_text", "label": "How do you make money?" },
          { "id": "cac", "type": "number", "label": "Customer acquisition cost" },
          { "id": "retention", "type": "text", "label": "How long do customers stay?" },
          { "id": "ltv", "type": "number", "label": "Lifetime value" },
          { "id": "scaling", "type": "long_text", "label": "What happens when you scale?" }
        ]
      },
      {
        "id": "execution",
        "title": "Velocity & Execution",
        "questions": [
          { "id": "start_date", "type": "date", "label": "When did you start?" },
          { "id": "last_30_days", "type": "long_text", "label": "What did you build in the last 30 days?" },
          { "id": "next_week", "type": "long_text", "label": "What are you building next week?" },
          { "id": "riskiest_assumption", "type": "long_text", "label": "Riskiest assumption" },
          { "id": "test_plan", "type": "long_text", "label": "How will you test it?" }
        ]
      },
      {
        "id": "vision",
        "title": "Vision & Ambition",
        "questions": [
          { "id": "big_outcome", "type": "long_text", "label": "How big can this be?" },
          { "id": "why_care", "type": "long_text", "label": "Why do you care?" },
          { "id": "failure_plan", "type": "long_text", "label": "What if this fails?" },
          { "id": "backup_plan", "type": "long_text", "label": "What will you do next?" }
        ]
      },
      {
        "id": "studio_fit",
        "title": "Studio Fit",
        "questions": [
          { "id": "needs", "type": "multi_select", "label": "What do you need most?", "options": ["product", "users", "tech", "growth", "funding", "hiring"] },
          { "id": "success_90_days", "type": "long_text", "label": "What does success in 90 days look like?" },
          { "id": "studio_help", "type": "long_text", "label": "What do you want the studio to help with?" },
          { "id": "equity", "type": "boolean", "label": "Open to equity for support?" },
          { "id": "equity_percentage", "type": "number", "label": "What % are you willing to give?" }
        ]
      }
    ]
  }
}
